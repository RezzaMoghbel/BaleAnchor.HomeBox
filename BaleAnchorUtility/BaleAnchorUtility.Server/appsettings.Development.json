{
  "Auth": {
    "Otp": {
      "OtpLength": 6,
      "OtpExpiryMinutes": 10,
      "MaxVerificationAttempts": 5,
      "ResendCooldownSeconds": 30,
      "MaxCodesPerHourPerEmail": 10,
      "SessionDurationHours": 24,
      "SessionCookieName": "bau.sid"
    }
  },
  "AdminAccess": {
    "AllowedEmails": [
      "*"
    ]
  },
  "EmailTransport": {
    "Mode": "log"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
