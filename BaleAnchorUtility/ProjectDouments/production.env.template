# BaleAnchor Utility production environment template
# Use as documentation reference only. Do not commit real secret values.

ASPNETCORE_ENVIRONMENT=Production

# Auth OTP
Auth__Otp__OtpLength=6
Auth__Otp__OtpExpiryMinutes=10
Auth__Otp__MaxVerificationAttempts=5
Auth__Otp__ResendCooldownSeconds=60
Auth__Otp__MaxCodesPerHourPerEmail=6
Auth__Otp__SessionDurationHours=24
Auth__Otp__SessionCookieName=bau.sid

# Admin bootstrap (optional)
AdminAccess__BootstrapAdminEmails__0=

# Seed access must stay disabled in production
SeedAccess__Enabled=false

# Email transport (smtp in production)
EmailTransport__Mode=smtp
EmailTransport__FromName=BaleAnchor Utility
EmailTransport__FromAddress=
EmailTransport__SmtpHost=
EmailTransport__SmtpPort=587
EmailTransport__SmtpUseSsl=true
EmailTransport__SmtpUsername=
EmailTransport__SmtpPassword=

# Push notifications
PushNotifications__Mode=log
PushNotifications__VapidSubject=
PushNotifications__VapidPublicKey=
PushNotifications__VapidPrivateKey=
PushNotifications__ReadingReminderDeepLinkPath=/dashboard/readings

# CSRF trusted origins
Security__AllowedOrigins__0=https://portal.example.com
